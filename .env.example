POSTGRES_DB=ruris
POSTGRES_USER=ruris
POSTGRES_PASSWORD=inlocuieste_cu_o_parola_locala
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

JWT_SECRET_KEY=
JWT_COOKIE_SECURE=false
JWT_ACCESS_TOKEN_MINUTES=15
WEB_PORT=8080
# Enable only when Flask is behind the trusted internal proxy.
BEHIND_PROXY=false

MAIL_TRANSPORT=LOCAL_MAILPIT
MAILPIT_SMTP_HOST=127.0.0.1
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
# Separate inbox for automated tests.
MAILPIT_TEST_SMTP_PORT=1026
MAILPIT_TEST_UI_PORT=8026
EMAIL_DAILY_TIME=08:00
EMAIL_RETRY_SECONDS=300

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=STARTTLS
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# Empty uses instance/attachments in the repository root.
ATTACHMENT_STORAGE_PATH=
